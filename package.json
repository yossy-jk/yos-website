{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:credential-scan && npm run test:download-token && npm run test:fitout-estimate && npm run test:auth-v2-session",
    "test:credential-scan": "node --test scripts/scan-source-credentials.test.mjs",
    "test:download-token": "node --test src/lib/download-token.test.mjs",
    "test:fitout-estimate": "node --no-warnings --experimental-strip-types --test src/lib/fitout-estimate.test.ts",
    "test:auth-v2-session": "node --no-warnings --experimental-strip-types --test src/lib/auth-v2-session.test.ts",
    "scan:credentials": "node scripts/scan-source-credentials.mjs",
    "check": "npm test && npm run scan:credentials && npm run lint && npm audit --audit-level=high && npm run build"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "glob": "^13.0.6",
    "jspdf": "^4.2.1",
    "konva": "^10.2.5",
    "lucide-react": "^1.8.0",
    "nanoid": "^5.1.9",
    "next": "^16.3.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-konva": "^19.2.3",
    "resend": "^6.12.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "puppeteer": "^25.9.0",
    "tailwindcss": "^4.2.3",
    "typescript": "5.9.3"
  }
}
