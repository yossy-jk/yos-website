<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Knight Frank LLP</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta http-equiv="X-UA-Compatible" content="IE=Edge" />
    <link rel="shortcut icon" href="/favicon.png" type="image/x-icon" />
    <link rel="icon" href="/favicon.png" type="image/x-icon" />
    <link rel="stylesheet" href="/library/v3.0/css/app.css" runat="server" id="lnkCss" />
    <style>
        .error404 {
            background-image: url(/library/v3.0/images/error.jpg);
            background-position: 50%;
            background-size: cover;
            position: relative;
            min-height: 100vh;
            margin: 0 !important;
            padding: 0 !important;
        }

            .error404 .overlay {
                background: rgba(0,0,0,.25) none repeat scroll 0 0;
                bottom: 0;
                content: "";
                left: 0;
                right: 0;
                top: 0;
                min-height: 100vh;
            }

                .error404 .overlay .container {
                    color: #ffffff;
                    text-align: center;
                    position: relative;
                    padding-top: 35vh;
                }
    </style>
    <script src="/library/v3.0/js/cms.min.js"></script>
</head>
<body id="bodyTag" class="bootstrap">
    <div class="content-wrapper-fixed-nav error404">
        <div class="fixed-nav">

            <section class="head">
                <div class="container">
                    <div class="row">
                        <div class="col-xs-6 col-md-5" itemscope="" itemtype="http://schema.org/Organization">
                            <a href="/" id="imgLogoLink" itemprop="url">
                                <img src="/library/v3.0/images/knightfranklogo.svg" id="imgLogo" alt="Knight Frank" itemprop="logo" />
                            </a>
                        </div>
                        <div class="col-xs-6 col-md-10 col-md-offset-2 header-list">
                            
                        </div>
                    </div>
                </div>
            </section>



        </div>
        <div class="overlay">
            <div class="container">
                <h1>Oops, the page you're looking for could not be found</h1>
                <p>Error 404: The page you requested does not exist or is currently unavailable</p>
                <p><a class="btn btn-danger btn-lg" href="/" role="button">Return to homepage</a></p>
            </div>
        </div>
    </div>
</body>
</html>
